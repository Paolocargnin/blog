# Set these in the Cloudflare Worker production environment only. They are
# public build configuration, not secrets. Leave the analytics token unset for
# local development and preview deployments so no analytics beacon is rendered.
PUBLIC_SITE_URL=https://blog.cargnin-paolo.workers.dev

# Create a site in Cloudflare Web Analytics and paste its public beacon token in
# the production dashboard. Do not commit the token in a local .env file.
PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
