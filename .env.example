# Set these in the Cloudflare Pages production environment only. They are public
# build configuration, not secrets. Leave both unset for local development and
# Preview deployments so no analytics beacon is rendered there.
PUBLIC_SITE_URL=https://pc-the-blog.pages.dev

# Create a site in Cloudflare Web Analytics and paste its public beacon token in
# the production dashboard. Do not commit the token in a local .env file.
PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
