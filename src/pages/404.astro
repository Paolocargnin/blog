---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="This page is not part of the public index.">
  <SiteHeader slot="header" currentPath={Astro.url.pathname} />
  <section class="not-found" id="top" aria-labelledby="not-found-title">
    <p>404 / MISSING FROM THE INDEX</p>
    <h1 id="not-found-title">Not found.</h1>
    <p>The page you requested is not part of this public record.</p>
    <a href="/">Return to reading</a>
  </section>
  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .not-found {
    min-height: 70vh;
    max-width: 88rem;
    margin-inline: auto;
    padding: clamp(5rem, 12vw, 11rem) clamp(1rem, 4vw, 2rem);
  }

  .not-found > p:first-child {
    margin: 0 0 1rem;
    color: var(--signal);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.05em;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.7rem, 10vw, 10rem);
    font-weight: 450;
    letter-spacing: -0.07em;
    line-height: 0.9;
  }

  .not-found > p:nth-of-type(2) {
    max-width: 45ch;
    margin: 2rem 0;
    color: var(--muted);
    line-height: 1.65;
  }

  a {
    color: var(--signal);
  }
</style>
