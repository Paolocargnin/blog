---
/**
 * The article view of a Post, shared by the English page (/posts/<slug>/) and
 * its Italian translation (/it/posts/<slug>/, ADR 0020). Metadata always comes
 * from the Post; the title, description, corrections and body change with the
 * language. The body is passed in the default slot.
 */
import AiNotice from './AiNotice.astro';
import Corrections from './Corrections.astro';
import Sources from './Sources.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, tagLabel, type Post } from '../lib/posts';

interface Props {
  post: Post;
  lang?: 'en' | 'it';
  title: string;
  description: string;
  corrections: Post['data']['corrections'];
  /** The same Post in the other language, when it exists. */
  alternate?: { href: string; lang: 'en' | 'it' };
}

const { post, lang = 'en', title, description, corrections, alternate } = Astro.props;
const text = {
  en: { updated: 'Updated', other: 'Leggi in italiano' },
  it: { updated: 'Aggiornato il', other: 'Read in English' },
}[lang];
const selfHref = lang === 'en' ? `/posts/${post.id}/` : `/it/posts/${post.id}/`;
const alternates = alternate
  ? [
      { hreflang: lang, href: selfHref },
      { hreflang: alternate.lang, href: alternate.href },
    ]
  : [];
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  alternates={alternates}
  pageType="article"
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
>
  <SiteHeader slot="header" currentPath={Astro.url.pathname} />
  <article id="top">
    <header class="article-header">
      <p class="article-meta">
        {post.data.tags.map(tagLabel).join(' / ')} / <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
        {
          alternate && (
            <>
              {' / '}
              <a class="language" href={alternate.href} hreflang={alternate.lang} lang={alternate.lang}>{text.other}</a>
            </>
          )
        }
      </p>
      <h1>{title}</h1>
      <p class="deck">{description}</p>
      {post.data.updatedAt && <p class="updated">{text.updated} {formatDate(post.data.updatedAt)}</p>}
    </header>
    {post.data.aiGenerated && <AiNotice lang={lang} />}
    <div class="prose"><slot /></div>
    <Sources sources={post.data.sources} />
    <Corrections corrections={corrections} lang={lang} />
  </article>
  <script>
    document.querySelectorAll<HTMLElement>('.prose pre').forEach((codeBlock) => {
      codeBlock.tabIndex = 0;
      codeBlock.setAttribute(
        'aria-label',
        'Code sample. Use arrow keys to scroll when needed.',
      );
    });

  </script>
  <div class="floating-number" aria-hidden="true">001</div>
  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .article-header {
    max-width: 70rem;
    margin-inline: auto;
    padding: clamp(5rem, 10vw, 10rem) clamp(1rem, 4vw, 2rem) 3rem;
  }

  .article-meta,
  .updated {
    margin: 0 0 1rem;
    color: var(--signal);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.05em;
    line-height: 1.5;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.575rem, 12.6vw, 10.8rem);
    font-weight: 430;
    letter-spacing: -0.065em;
    line-height: 0.89;
    text-wrap: balance;
  }

  .deck {
    max-width: 58ch;
    margin: 2.5rem 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.25rem);
    line-height: 1.6;
  }

  .updated {
    margin-top: 1.5rem;
    color: var(--muted);
  }

  .language {
    color: var(--ink);
  }

  .prose {
    max-width: var(--measure);
    margin-inline: auto;
    padding: 0 clamp(1rem, 4vw, 2rem) clamp(3rem, 8vw, 7rem);
    font-size: clamp(1.05rem, 0.98rem + 0.3vw, 1.28rem);
    line-height: 1.74;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote),
  .prose :global(pre) {
    margin-block: 0 1.65em;
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin: 3em 0 0.7em;
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .prose :global(h2) {
    font-size: clamp(2rem, 1.5rem + 1.3vw, 3.5rem);
  }

  .prose :global(h3) {
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 2rem);
  }

  .prose :global(blockquote) {
    padding: 1.5em 0;
    border-block: 1px solid var(--signal);
    color: var(--signal);
    font-size: 1.3em;
    line-height: 1.35;
  }

  .prose :global(pre) {
    width: min(80rem, calc(100vw - 2rem));
    margin-inline: 50%;
    padding: clamp(1.25rem, 4vw, 3rem);
    overflow-x: auto;
    border: 1px solid var(--line);
    background: #090a0b;
    color: var(--ink);
    font-size: 0.78em;
    line-height: 1.7;
    transform: translateX(-50%);
  }

  .prose :global(code) {
    font-family: inherit;
  }

  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.25em;
    background: var(--panel);
  }

  .prose :global(img) {
    margin: 2em auto;
  }

  .prose :global(img),
  .prose :global(video) {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }

  .prose :global(img) {
    width: auto;
    max-height: 85vh;
  }

  .prose :global(figure) {
    margin: 2.5em 0;
  }

  .prose :global(figure img),
  .prose :global(figure video) {
    margin: 0 auto;
  }

  .prose :global(figure.pixel img),
  .prose :global(figure.pixel video) {
    width: 100%;
    image-rendering: pixelated;
  }

  .prose :global(figcaption),
  .prose :global(.caption) {
    margin-top: 0.8em;
    color: var(--muted);
    font-size: 0.8em;
    line-height: 1.5;
  }

  .floating-number {
    position: fixed;
    z-index: 1;
    inset-inline-start: clamp(0.25rem, 1vw, 1rem);
    inset-block-end: -0.18em;
    pointer-events: none;
    color: var(--signal);
    font-size: clamp(3.575rem, 18.2vw, 10.8rem);
    font-weight: 700;
    letter-spacing: -0.13em;
    line-height: 0.8;
    mix-blend-mode: exclusion;
  }

  @media (min-width: 43rem) {
    h1 {
      font-size: clamp(5.4rem, 7.6vw, 10.8rem);
    }
  }

</style>
