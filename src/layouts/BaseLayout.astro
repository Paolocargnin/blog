---
import '@fontsource-variable/jetbrains-mono';

interface Props {
  description?: string;
  pageType?: 'article' | 'website';
  publishedAt?: Date;
  title: string;
  updatedAt?: Date;
}

const { description, pageType = 'website', publishedAt, title, updatedAt } = Astro.props;
const siteName = 'PC - the blog';
const documentTitle = title === siteName ? siteName : `${title} · ${siteName}`;
const canonicalUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? 'https://pctb.it',
).href;
const configuredAnalyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN?.trim();
const analyticsToken = import.meta.env.PROD && configuredAnalyticsToken
  ? configuredAnalyticsToken
  : undefined;
const structuredData =
  pageType === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        author: {
          '@type': 'Person',
          name: 'Paolo Cargnin',
        },
        dateModified: (updatedAt ?? publishedAt)?.toISOString(),
        datePublished: publishedAt?.toISOString(),
        description,
        headline: title,
        mainEntityOfPage: canonicalUrl,
        url: canonicalUrl,
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        description,
        isPartOf: {
          '@type': 'WebSite',
          name: siteName,
          url: new URL(
            '/',
            Astro.site ?? 'https://pctb.it',
          ).href,
        },
        name: documentTitle,
        url: canonicalUrl,
      };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} RSS feed`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={pageType === 'article' ? 'article' : 'website'} />
    <meta property="og:title" content={documentTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={documentTitle} />
    {description && <meta name="twitter:description" content={description} />}
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {
      analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      )
    }
    <title>{documentTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot name="header" />
    <main id="main-content"><slot /></main>
    <slot name="footer" />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --ground: #121416;
    --panel: #1b1e21;
    --ink: #f2f3ec;
    --muted: #b7bcb4;
    --line: #4e5350;
    --signal: #d8ff68;
    --measure: 75ch;
    background: var(--ground);
    color: var(--ink);
    font-family: 'JetBrains Mono Variable', monospace;
    font-synthesis: none;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--ground);
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  a {
    color: inherit;
    text-decoration-color: var(--signal);
    text-underline-offset: 0.2em;
  }

  a:focus-visible,
  button:focus-visible,
  [tabindex]:focus-visible {
    outline: 0.2rem solid var(--signal);
    outline-offset: 0.25rem;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  .skip-link {
    position: fixed;
    z-index: 10;
    inset-block-start: 0.75rem;
    inset-inline-start: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--signal);
    color: var(--ground);
    font-weight: 700;
    transform: translateY(calc(-100% - 1rem));
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
